<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Clash 订阅管理</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bs-body-bg: #f8f9fa;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
            min-height: 100vh;
        }
        .navbar-brand i { margin-right: 0.5rem; }
        .page-container { padding-top: 1rem; padding-bottom: 3rem; }
        .card-hover { transition: all 0.2s ease; }
        .card-hover:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.08); }
        .rule-card { margin-bottom: 0.75rem; }
        .toggle-switch { width: 3rem; height: 1.5rem; position: relative; display: inline-block; }
        .main-content { min-height: calc(100vh - 60px - 40px); }
        .btn-action { min-height: 38px; min-width: 38px; }
        @@media (max-width: 767.98px) {
            .desktop-only { display: none !important; }
            .mobile-full { width: 100%; }
        }
        @@media (min-width: 768px) {
            .mobile-only { display: none !important; }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-shield-shaded"></i>ClashSub
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index"><i class="bi bi-speedometer2 me-1"></i>仪表盘</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Rules/Index"><i class="bi bi-list-check me-1"></i>规则管理</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Rules/Import"><i class="bi bi-upload me-1"></i>导入规则</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Settings"><i class="bi bi-gear me-1"></i>设置</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container main-content page-container">
        @RenderBody()
    </div>

    <footer class="text-center py-3 text-muted small border-top bg-white">
        <div class="container">
            &copy; @DateTime.Now.Year Clash Subscription Server &mdash; Powered by ASP.NET Core 8
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        window.copyToClipboard = async function(text) {
            try {
                await navigator.clipboard.writeText(text);
                var toast = new bootstrap.Toast(document.getElementById('copyToast') || createToast('复制成功!'));
                toast.show();
                return true;
            } catch (e) {
                alert('复制失败: ' + e.message);
                return false;
            }
        };
        function createToast(msg) {
            var el = document.createElement('div');
            el.className = 'toast align-items-center text-bg-success border-0 position-fixed';
            el.style.cssText = 'top:20px;right:20px;z-index:9999;';
            el.innerHTML = '<div class="d-flex"><div class="toast-body">' + msg + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>';
            document.body.appendChild(el);
            return el;
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
