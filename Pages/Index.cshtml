@page
@using ClashServer.Models
@model IndexModel
@{
    ViewData["Title"] = "仪表盘";
}

<div class="mb-4">
    <h1 class="h3 mb-0 fw-bold"><i class="bi bi-speedometer2 text-primary me-2"></i>仪表盘</h1>
    <p class="text-muted small mt-1 mb-0">Clash 订阅合并与规则管理控制台</p>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.RefreshOk == false ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">总规则数</p>
                        <h3 class="fw-bold mb-0">@Model.Rules.Count</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-list-check text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">启用中</p>
                        <h3 class="fw-bold mb-0 text-success">@Model.EnabledRuleCount</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-toggle-on text-success fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">代理节点</p>
                        <h3 class="fw-bold mb-0 text-info">@Model.Nodes.Count</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-diagram-3 text-info fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">缓存时长</p>
                        <h3 class="fw-bold mb-0 text-warning">@Model.Settings.CacheMinutes<span class="fs-6 ms-1">分钟</span></h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                        <i class="bi bi-clock-history text-warning fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between border-bottom">
                <h5 class="mb-0 fw-bold"><i class="bi bi-link-45deg text-primary me-2"></i>我的订阅地址</h5>
                <form method="post" asp-page-handler="RefreshCache" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise me-1"></i>强制刷新缓存
                    </button>
                </form>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-muted">订阅 URL (Clash 客户端使用)</label>
                    <div class="input-group">
                        <input type="text" id="subUrlInput" class="form-control form-control-lg" value="@Model.SubUrl" readonly>
                        <button class="btn btn-primary btn-lg" type="button" onclick="copyToClipboard(document.getElementById('subUrlInput').value)">
                            <i class="bi bi-clipboard me-1"></i>复制
                        </button>
                    </div>
                    @if (string.IsNullOrWhiteSpace(Model.Settings.AccessToken))
                    {
                        <div class="form-text text-warning mt-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>访问 Token 未设置，任何人均可访问此订阅地址，建议立即前往设置页面配置。
                        </div>
                    }
                    else
                    {
                        <div class="form-text text-muted mt-2">
                            <i class="bi bi-shield-check text-success me-1"></i>Token 校验已启用。Clash 客户端也可以使用 HTTP Header: <code>Authorization: Bearer @Model.Settings.AccessToken</code>
                        </div>
                    }
                </div>
                <div class="alert alert-light border small mb-0">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            <strong>使用方式：</strong>将上方地址复制到 Clash / Clash Verge / mihomo 等客户端的「订阅 URL」配置中即可。
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a class="btn btn-sm btn-outline-primary me-1" asp-page="/Rules/Index"><i class="bi bi-list-check me-1"></i>管理规则</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Settings"><i class="bi bi-gear me-1"></i>配置设置</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.NodesError))
        {
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body text-center py-4">
                    <div class="mb-2 text-warning"><i class="bi bi-exclamation-triangle fs-2"></i></div>
                    <p class="text-muted mb-1">无法加载节点信息</p>
                    <p class="text-danger small">@Model.NodesError</p>
                    <p class="text-muted small">请检查上游订阅 URL 是否已正确配置。</p>
                </div>
            </div>
        }
        else if (Model.Nodes.Count > 0)
        {
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white d-flex align-items-center justify-content-between border-bottom flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-diagram-3 text-info me-2"></i>代理节点
                        <span class="badge text-bg-info ms-1">@Model.Nodes.Count</span>
                    </h5>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <select class="form-select form-select-sm" id="nodeSortSelect" onchange="sortNodes(this.value)" style="width:auto;">
                            <option value="default">默认顺序</option>
                            <option value="name-asc">名称 A-Z</option>
                            <option value="name-desc">名称 Z-A</option>
                            <option value="type">类型</option>
                            <option value="latency-asc">延时 低→高</option>
                            <option value="latency-desc">延时 高→低</option>
                        </select>
                        <button class="btn btn-sm btn-outline-success" onclick="testAllLatency()">
                            <i class="bi bi-speedometer me-1"></i>全部测速
                        </button>
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn btn-outline-secondary active" id="viewGridBtn" onclick="setView('grid')">
                                <i class="bi bi-grid"></i>
                            </button>
                            <button class="btn btn-outline-secondary" id="viewListBtn" onclick="setView('list')">
                                <i class="bi bi-list-ul"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="nodeGrid" class="row g-2">
                        @foreach (var node in Model.Nodes)
                        {
                            <div class="col-md-6 col-xl-4 node-item" data-name="@node.Name" data-type="@node.Type">
                                <div class="card border node-card h-100">
                                    <div class="card-body p-2 d-flex align-items-center gap-2">
                                        <span class="badge text-bg-@node.TypeBadgeColor node-type" style="min-width:45px;">@node.Type</span>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-semibold text-truncate small" title="@node.Name">@node.Name</div>
                                            <div class="text-muted" style="font-size:0.7rem;">@node.Server:@node.Port</div>
                                        </div>
                                        <span class="badge text-bg-secondary node-latency" data-name="@node.Name">
                                            <i class="bi bi-dash-circle"></i>
                                        </span>
                                        <button class="btn btn-sm btn-outline-primary btn-action node-test-btn" data-name="@node.Name" title="测试延时">
                                            <i class="bi bi-lightning-charge"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div id="nodeList" class="d-none">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:60px;">类型</th>
                                        <th>节点名称</th>
                                        <th>服务器</th>
                                        <th style="width:80px;">端口</th>
                                        <th style="width:100px;">延时</th>
                                        <th style="width:60px;">测试</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var node in Model.Nodes)
                                    {
                                        <tr data-name="@node.Name" data-type="@node.Type">
                                            <td><span class="badge text-bg-@node.TypeBadgeColor">@node.Type</span></td>
                                            <td class="fw-semibold small">@node.Name</td>
                                            <td class="text-muted small font-monospace">@node.Server</td>
                                            <td class="small">@node.Port</td>
                                            <td><span class="badge text-bg-secondary node-latency" data-name="@node.Name"><i class="bi bi-dash-circle"></i></span></td>
                                            <td><button class="btn btn-sm btn-outline-primary node-test-btn" data-name="@node.Name"><i class="bi bi-lightning-charge"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0 fw-bold"><i class="bi bi-cloud-download text-primary me-2"></i>上游状态</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">配置的上游 URL</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" value="@Model.Settings.UpstreamUrl" readonly placeholder="请先在【设置】页面配置上游订阅 URL">
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span id="upstreamStatus">
                        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                        <span class="text-muted small">检测中...</span>
                    </span>
                </div>
                <button class="btn btn-sm btn-outline-primary w-100" onclick="testUpstream()">
                    <i class="bi bi-play-circle me-1"></i>重新检测上游连通性
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0 fw-bold"><i class="bi bi-lightning text-warning me-2"></i>快捷操作</h5>
            </div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action d-flex align-items-center" asp-page="/Rules/Index">
                    <i class="bi bi-pencil-square me-3 text-primary"></i>
                    <div class="me-auto">
                        <div class="fw-semibold">添加/编辑规则</div>
                        <div class="small text-muted">在线维护自定义 Clash 规则</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a class="list-group-item list-group-item-action d-flex align-items-center" asp-page="/Rules/Import">
                    <i class="bi bi-upload me-3 text-success"></i>
                    <div class="me-auto">
                        <div class="fw-semibold">批量导入规则</div>
                        <div class="small text-muted">粘贴或上传 YAML 规则列表</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                <a class="list-group-item list-group-item-action d-flex align-items-center" asp-page="/Settings">
                    <i class="bi bi-gear me-3 text-secondary"></i>
                    <div class="me-auto">
                        <div class="fw-semibold">系统设置</div>
                        <div class="small text-muted">上游 URL、Token、缓存参数</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function testUpstream() {
        var el = document.getElementById('upstreamStatus');
        el.innerHTML = '<span class="spinner-border spinner-border-sm text-secondary" role="status"></span> <span class="text-muted small">检测中...</span>';
        try {
            var resp = await fetch('?handler=TestUpstream');
            var data = await resp.json();
            if (data.ok) {
                el.innerHTML = '<span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>上游可访问</span>';
            } else {
                el.innerHTML = '<span class="badge text-bg-danger"><i class="bi bi-x-circle me-1"></i>上游无法访问，请检查 URL</span>';
            }
        } catch (e) {
            el.innerHTML = '<span class="badge text-bg-warning">检测请求出错</span>';
        }
    }
    document.addEventListener('DOMContentLoaded', testUpstream);

    // 事件委托：绑定测速按钮点击
    document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.node-test-btn');
            if (btn) {
                var name = btn.getAttribute('data-name');
                if (name) testLatency(name);
            }
        });
    });

    function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function updateLatencyBadge(name, latency, error) {
        var badges = document.querySelectorAll('.node-latency[data-name="' + CSS.escape(name) + '"]');
        badges.forEach(function(badge) {
            if (error) {
                badge.className = 'badge text-bg-danger node-latency';
                badge.innerHTML = '<i class="bi bi-x-circle"></i>';
                badge.title = error;
            } else if (latency != null) {
                var color = latency < 100 ? 'success' : latency < 300 ? 'primary' : latency < 1000 ? 'warning' : 'danger';
                badge.className = 'badge text-bg-' + color + ' node-latency';
                badge.innerHTML = latency + 'ms';
                badge.title = latency + 'ms';
            } else {
                badge.className = 'badge text-bg-secondary node-latency';
                badge.innerHTML = '<i class="bi bi-dash-circle"></i>';
            }
        });
    }

    function setBtnLoading(name, loading) {
        var btns = document.querySelectorAll('.node-test-btn');
        btns.forEach(function(btn) {
            if (btn.getAttribute('data-name') === name) {
                btn.disabled = loading;
                if (loading) {
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                } else {
                    btn.innerHTML = '<i class="bi bi-lightning-charge"></i>';
                }
            }
        });
    }

    async function testLatency(name) {
        setBtnLoading(name, true);
        updateLatencyBadge(name, null, null);
        document.querySelectorAll('.node-latency[data-name="' + CSS.escape(name) + '"]').forEach(function(b) {
            b.className = 'badge text-bg-info node-latency';
            b.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        });
        try {
            var resp = await fetch('?handler=TestLatency&name=' + encodeURIComponent(name));
            var data = await resp.json();
            if (data.ok) {
                updateLatencyBadge(name, data.latency, null);
            } else {
                updateLatencyBadge(name, null, data.error || '测试失败');
            }
        } catch (e) {
            updateLatencyBadge(name, null, e.message);
        }
        setBtnLoading(name, false);
    }

    var testingAll = false;
    async function testAllLatency() {
        if (testingAll) return;
        testingAll = true;
        var names = [];
        document.querySelectorAll('.node-latency').forEach(function(el) {
            var n = el.getAttribute('data-name');
            if (names.indexOf(n) === -1) names.push(n);
        });
        var concurrency = 8;
        var idx = 0;
        async function worker() {
            while (idx < names.length) {
                var name = names[idx++];
                await testLatency(name);
            }
        }
        var workers = [];
        for (var i = 0; i < concurrency; i++) workers.push(worker());
        await Promise.all(workers);
        testingAll = false;
    }

    function setView(view) {
        var grid = document.getElementById('nodeGrid');
        var list = document.getElementById('nodeList');
        var gridBtn = document.getElementById('viewGridBtn');
        var listBtn = document.getElementById('viewListBtn');
        if (view === 'list') {
            grid.classList.add('d-none');
            list.classList.remove('d-none');
            gridBtn.classList.remove('active');
            listBtn.classList.add('active');
        } else {
            grid.classList.remove('d-none');
            list.classList.add('d-none');
            gridBtn.classList.add('active');
            listBtn.classList.remove('active');
        }
    }

    // 保存默认顺序
    var gridOriginalOrder = null;
    var listOriginalOrder = null;

    function getLatencyFromBadge(container) {
        var badge = container.querySelector('.node-latency');
        if (!badge) return null;
        var text = badge.textContent.trim();
        var match = text.match(/(\d+)\s*ms/);
        return match ? parseInt(match[1]) : null;
    }

    function sortNodes(sortBy) {
        var grid = document.getElementById('nodeGrid');
        var listBody = document.querySelector('#nodeList tbody');

        // 保存默认顺序
        if (!gridOriginalOrder) {
            gridOriginalOrder = Array.from(grid.children);
            listOriginalOrder = Array.from(listBody.children);
        }

        var gridItems = Array.from(gridOriginalOrder);
        var listItems = Array.from(listOriginalOrder);

        if (sortBy === 'default') {
            gridOriginalOrder.forEach(function(el) { grid.appendChild(el); });
            listOriginalOrder.forEach(function(el) { listBody.appendChild(el); });
            return;
        }

        function getSortValue(item) {
            if (sortBy === 'name-asc' || sortBy === 'name-desc') {
                return item.getAttribute('data-name') || '';
            }
            if (sortBy === 'type') {
                return item.getAttribute('data-type') || '';
            }
            if (sortBy === 'latency-asc' || sortBy === 'latency-desc') {
                return getLatencyFromBadge(item);
            }
            return '';
        }

        function compare(a, b) {
            var va = getSortValue(a);
            var vb = getSortValue(b);

            if (sortBy === 'latency-asc' || sortBy === 'latency-desc') {
                // null (未测试) 排到最后
                if (va == null && vb == null) return 0;
                if (va == null) return 1;
                if (vb == null) return -1;
                return sortBy === 'latency-asc' ? va - vb : vb - va;
            }

            if (sortBy === 'name-desc') {
                return vb.localeCompare(va, 'zh-CN');
            }
            return va.localeCompare(vb, 'zh-CN');
        }

        gridItems.sort(compare);
        listItems.sort(compare);

        gridItems.forEach(function(el) { grid.appendChild(el); });
        listItems.forEach(function(el) { listBody.appendChild(el); });
    }
</script>
}
